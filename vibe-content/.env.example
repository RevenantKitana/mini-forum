# Forum Backend — full versioned URL including /api/v1
FORUM_API_URL=http://localhost:5000/api/v1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mini_forum?schema=public

# LLM Providers — Phase 1 only needs GEMINI_API_KEY
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=

# Bot user password (must match what was used in seed)
BOT_PASSWORD=BotUser@123

# Scheduler
CRON_SCHEDULE=*/30 * * * *
BATCH_SIZE=1

# Limits
MAX_POSTS_PER_USER_DAY=3
MAX_COMMENTS_PER_USER_DAY=6
MAX_VOTES_PER_USER_DAY=15

# Provider
PROVIDER_TIMEOUT_MS=30000

# Service
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# CORS — allowed origins (comma-separated domains/URLs)
# Development: allows localhost ports for frontend
# Production: locked to specific domain
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# CORS — allowed IPs (comma-separated IP addresses)
# Optional: for IP-based whitelisting (e.g., 192.168.1.100, 10.0.0.50)
# Leave empty if not needed
CORS_IPS=
