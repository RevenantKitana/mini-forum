# ==============================================================================
# Mini Forum - Production Environment Variables
# ==============================================================================

# Database Credentials (used by PostgreSQL container and services)
POSTGRES_USER=forum_user
POSTGRES_PASSWORD=forum_secure_pass_2026
POSTGRES_DB=mini_forum

# Server Config
PORT=5000
NODE_ENV=production
LOG_LEVEL=info

# JWT Secrets (generate using: openssl rand -base64 32)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Allowed Frontend URLs (comma-separated, e.g. Vercel deployment and local admin)
FRONTEND_URL=https://your-forum.vercel.app,https://your-admin.vercel.app
COMMENT_EDIT_TIME_LIMIT=30

# Email Service (Brevo API for OTP and auth)
BREVO_API_KEY=your_brevo_api_key
BREVO_FROM_EMAIL=noreply@yourdomain.com
BREVO_FROM_NAME="Mini Forum"

# Image Storage (ImageKit)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# Vibe Content - AI Bot Generator (Gemini API)
GEMINI_API_KEY=your_gemini_api_key

# Cloudflare Tunnel Token (Optional, get from Cloudflare Zero Trust > Tunnels)
TUNNEL_TOKEN=your_cloudflare_tunnel_token_here
